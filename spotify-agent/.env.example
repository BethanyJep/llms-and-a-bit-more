# Azure AI Foundry Agent Service (Microsoft Agent Framework)
# Get your project endpoint from: https://ai.azure.com -> Your Project -> Overview
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4.1
AZURE_AI_FOUNDRY_MODEL=gpt-4.1

# Spotify API credentials
# Get from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
