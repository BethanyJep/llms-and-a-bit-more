# Azure OpenAI Configuration
# Get these values from your Azure OpenAI resource in the Azure Portal

# Your Azure OpenAI API key (from "Keys and Endpoint" section)
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here

# Your Azure OpenAI endpoint (e.g., https://your-resource-name.openai.azure.com/)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# The API version to use (recommended: 2024-02-15-preview or later)
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Your deployment name for GPT-4 or GPT-4o-mini
# This is the name you gave when you deployed the model in Azure
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini

# Optional: Set to "true" to use regular OpenAI instead of Azure
# If true, set OPENAI_API_KEY instead of Azure variables
USE_OPENAI=false
OPENAI_API_KEY=sk-your-openai-api-key-here
